{
  "schemaVersion": "1.0",
  "contextRules": [
    {
      "match": { "contextType": "decision" },
      "distributions": [
        { "id": "decision.next_step_by_segment", "facetKey": "decision_outcome", "title": "Next step after the visit" },
        { "id": "decision.converted_by_segment", "facetKey": "converted", "title": "Would engage sales" },
        { "id": "decision.trust_action_by_segment", "facetKey": "trust_action", "title": "Needed before going further" },
        { "id": "decision.contact_likelihood_by_segment", "facetKey": "contact_likelihood", "title": "Likelihood of contacting (1-7)" },
        { "id": "decision.basis_by_segment", "facetKey": "basis_primary", "title": "Primary basis" }
      ],
      "summaryAnalyses": [
        {
          "id": "decision.reason_by_tier",
          "title": "What each audience segment concluded",
          "targetFacetKey": "reason",
          "groupByPersonaDimension": "tier",
          "summaryKind": "llm_bucket_summary",
          "instruction": "For each audience tier (main contractor, subcontractor, developer/client, rental company), summarize in 1-2 sentences what these personas took away from their visit and what drove their next step, so the site owner sees how the segments differ. Be faithful and concise; do not invent facts."
        }
      ]
    },
    {
      "match": { "contextType": "decision_process" },
      "distributions": [
        { "id": "journey.exit_section_by_segment", "facetKey": "exit_section", "title": "Where they stopped" },
        { "id": "journey.reached_pricing_by_segment", "facetKey": "reached_pricing_by_url", "title": "Reached pricing" },
        { "id": "journey.reached_contact_by_segment", "facetKey": "reached_contact_by_url", "title": "Reached contact / demo / trial" },
        { "id": "journey.pages_by_segment", "facetKey": "pages_visited_count", "title": "Pages opened" },
        { "id": "journey.stopped_by_segment", "facetKey": "stopped_because", "title": "Why the visit ended" },
        { "id": "journey.found_by_segment", "facetKey": "found_what_needed", "title": "Found what they needed" },
        { "id": "journey.consistent_by_segment", "facetKey": "journey_consistent", "title": "Journey self-report consistent" }
      ],
      "summaryAnalyses": [
        {
          "id": "journey.obstacles_by_tier",
          "title": "What got in the way, by audience",
          "targetFacetKey": "comparison_notes",
          "groupByPersonaDimension": "tier",
          "summaryKind": "llm_bucket_summary",
          "instruction": "For each audience tier, cluster the obstacles these personas ran into on the site into at most three concrete themes, ordered by how often they come up, each with a short title and one representative verbatim quote. Do not invent obstacles that were not mentioned."
        }
      ]
    },
    {
      "match": { "contextType": "visit_feedback" },
      "distributions": [
        { "id": "visit.clarity_by_segment", "facetKey": "clarity", "title": "Clarity: what it would do for me (1-7)" },
        { "id": "visit.trust_by_segment", "facetKey": "trust", "title": "Trust: would rely on them (1-7)" },
        { "id": "visit.missing_by_segment", "facetKey": "missing_info", "title": "What is missing" }
      ]
    },
    {
      "match": { "contextType": "site_improvement" },
      "distributions": [
        { "id": "site_improvement.obstacle_by_segment", "facetKey": "biggest_obstacle", "title": "Biggest obstacle" }
      ],
      "summaryAnalyses": [
        {
          "id": "site_improvement.suggestions_by_tier",
          "title": "What to change, clustered by audience",
          "targetFacetKey": "improvement_suggestion",
          "groupByPersonaDimension": "tier",
          "summaryKind": "llm_bucket_summary",
          "instruction": "For each audience tier, cluster these suggested changes into at most four concrete themes, ordered by how often they come up. For each theme give a short imperative title and one representative verbatim quote. These are instructions to the website owner, so keep them specific and actionable. Do not invent suggestions that were not made."
        }
      ]
    }
  ]
}
